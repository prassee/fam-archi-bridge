{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "title": "PostgreSQL Up",
      "type": "stat",
      "targets": [
        {
          "expr": "pg_up",
          "legendFormat": "pg_up"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "options": {
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "title": "Active Connections",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count{datname=\"postgres\",state!=\"disabled\"})",
          "legendFormat": "connections"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      }
    },
    {
      "title": "Replication Slot Active",
      "type": "stat",
      "targets": [
        {
          "expr": "pg_replication_slot_slot_is_active{slot_name=~\"wal_writer_slot.*\"}",
          "legendFormat": "{{slot_name}}"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "options": {
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "INACTIVE",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ACTIVE",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "title": "Slot Lag Now (GB)",
      "type": "stat",
      "targets": [
        {
          "expr": "pg_replication_slots_pg_wal_lsn_diff{slot_name=~\"wal_writer_slot.*\"} / 1073741824",
          "legendFormat": "{{slot_name}}"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "options": {
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "gbytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      }
    },
    {
      "title": "WAL Size (GB)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "pg_wal_size_bytes / 1073741824",
          "legendFormat": "WAL Size"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "gbytes"
        }
      }
    },
    {
      "title": "Slot Lag Over Time (GB)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "pg_replication_slots_pg_wal_lsn_diff{slot_name=~\"wal_writer_slot.*\"} / 1073741824",
          "legendFormat": "{{slot_name}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "gbytes"
        }
      }
    },
    {
      "title": "Database Size (GB)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname!~\"template.*\"} / 1073741824",
          "legendFormat": "{{datname}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "gbytes"
        }
      }
    },
    {
      "title": "Slot LSN Position",
      "type": "timeseries",
      "targets": [
        {
          "expr": "pg_replication_slot_slot_confirmed_flush_lsn{slot_name=~\"wal_writer_slot.*\"}",
          "legendFormat": "{{slot_name}} confirmed_flush_lsn"
        },
        {
          "expr": "pg_replication_slot_slot_current_wal_lsn{slot_name=~\"wal_writer_slot.*\"}",
          "legendFormat": "{{slot_name}} current_wal_lsn"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      }
    },
    {
      "title": "WAL Sender LSN Diff (bytes)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "pg_stat_replication_pg_wal_lsn_diff",
          "legendFormat": "{{application_name}} {{state}} slot={{slot_name}}"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 20
      }
    },
    {
      "title": "Safe WAL Size Remaining (GB)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "pg_replication_slot_safe_wal_size_bytes{slot_name=~\"wal_writer_slot.*\"} / 1073741824",
          "legendFormat": "{{slot_name}}"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "gbytes"
        }
      }
    }
  ],
  "schemaVersion": 38,
  "tags": [],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "PostgreSQL Monitoring",
  "uid": "postgres-monitoring",
  "refresh": "5s"
